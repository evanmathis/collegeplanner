# Copy to .env (never commit .env) and fill in. The website and `flask` commands read it.
SECRET_KEY=replace-with-a-long-random-string
PLANNER_PASSWORD=pick-a-password-for-cian
# Secret part of the calendar subscription URL (Calendar page). Leave out to turn the feed off.
CALENDAR_TOKEN=another-long-random-string
# MySQL on DreamHost. Leave these out to use SQLite in instance/planner.db.
DB_HOST=schoolpicker.zonelab.app
DB_USER=three5
DB_PASSWORD='your-mysql-password'
DB_NAME=schoolpicker
