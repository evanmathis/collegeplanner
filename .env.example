# Copy to .env (never commit .env). Used by passenger_wsgi.py on DreamHost.
SECRET_KEY=replace-with-a-long-random-string
PLANNER_PASSWORD=pick-a-password-for-cian
# MySQL on DreamHost (leave out to use SQLite in instance/planner.db):
DATABASE_URL=mysql+pymysql://DBUSER:DBPASSWORD@mysql.yourdomain.com/collegeplanner?charset=utf8mb4
# Secret part of the calendar subscription URL (Calendar page). Leave out to turn the feed off.
CALENDAR_TOKEN=another-long-random-string
