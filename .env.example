# Copy to .env (never commit .env) and fill in. The website and `flask` commands read it.
SECRET_KEY=replace-with-a-long-random-string
PLANNER_PASSWORD=pick-a-shared-password
# Points game: a second secret only Evan and Amy know. Needed to verify, change points or
# the pot, and record payments. Cian logs in with the shared password alone.
PARENT_PIN=pick-a-parent-pin
# Who can log in (defaults shown).
#PARENT_NAMES=Evan,Amy
#STUDENT_NAME=Cian
# Secret part of the calendar subscription URL (Calendar page). Leave out to turn the feed off.
CALENDAR_TOKEN=another-long-random-string
# MySQL on DreamHost. Leave these out to use SQLite in instance/planner.db.
DB_HOST=schoolpicker.zonelab.app
DB_USER=three5
DB_PASSWORD='your-mysql-password'
DB_NAME=schoolpicker
